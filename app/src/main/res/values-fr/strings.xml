    <string name="config_titulo">Configurer les durées</string>
    <string name="config_sesion_activa">Une session est en cours. Termine-la ou annule-la pour pouvoir modifier les durées.</string>
    <string name="config_opciones_predeterminadas">OPTIONS PAR DÉFAUT</string>
    <string name="config_opciones_predeterminadas_texto">25 min de concentration, 5 min de pause courte et 15 min de pause longue. Si tu actives cette option, tu ne pourras plus modifier les durées ci-dessous.</string>
    <string name="config_tiempo_enfoque">DURÉE DE CONCENTRATION</string>
    <string name="config_tiempo_enfoque_texto">Durée des blocs de travail</string>
    <string name="config_descanso_corto">PAUSE COURTE</string>
    <string name="config_descanso_corto_texto">Durée de la pause entre les cycles</string>
    <string name="config_activar_descanso_largo">ACTIVER LA PAUSE LONGUE</string>
    <string name="config_activar_descanso_largo_texto">Une fois les 4 cycles terminés, tu prends une pause plus longue. Si tu comptes continuer à étudier ensuite, il vaut mieux l\'activer ; si tu comptes t\'arrêter, tu peux la désactiver et le chrono s\'arrêtera au quatrième cycle.</string>
    <string name="config_duracion_descanso_largo">DURÉE DE LA PAUSE LONGUE</string>
