    <string name="acerca_titulo">À propos</string>
    <string name="acerca_version">Version %1$s</string>
    <string name="acerca_la_app">L\'APPLI</string>
    <string name="acerca_la_app_texto">Miau Focus est une appli de concentration basée sur la technique Pomodoro, pour étudier sans te laisser distraire, en compagnie d\'un chaton. Faite avec soin par une petite équipe indépendante.</string>
    <string name="acerca_como_hecha">COMMENT ELLE EST FAITE</string>
    <string name="acerca_como_hecha_texto">Application Android native, écrite en Java. Elle ne demande pas d\'autorisation internet, n\'affiche pas de publicités et n\'exige aucun compte. Toutes tes informations restent uniquement sur ton appareil.</string>
