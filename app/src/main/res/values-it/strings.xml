    <string name="acerca_la_app">L\'APP</string>
    <string name="acerca_la_app_texto">Miau Focus è un\'app di concentrazione con la tecnica del pomodoro per studiare senza distrarti, in compagnia di un gattino. Fatta con cura da un piccolo team indipendente.</string>
