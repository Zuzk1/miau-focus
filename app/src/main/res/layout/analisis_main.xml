<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeFondoPrincipal"
    android:clipToPadding="false"
    tools:context=".analisisActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/themeFondoPrincipal"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/themeFondoPrincipal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:text="@string/analisis_titulo"
                android:textColor="?attr/themeTextoPrimario"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_semibold"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:paddingEnd="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivEscudo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_config_general"
                    app:tint="@color/color_verde_exito" />

                <ImageView
                    android:id="@+id/ivConfigTiempo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_configtiempo"
                    app:tint="?attr/themeTextoPrimario" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llPuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/carta_oscura"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_gato_cabeza"
                    android:contentDescription="@string/cd_puntos"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/tvPuntos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="?attr/themeTextoPrimario"
                    android:textSize="18sp"
                    tools:text="350 Puntos" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTienda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/analisis_tienda_temas"
                    android:textColor="?attr/themeSobreAcento"
                    android:textSize="13sp"
                    app:backgroundTint="?attr/themeAcento"
                    app:cornerRadius="24dp"
                    app:rippleColor="?attr/themeRipple" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/carta_oscura"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:id="@+id/llFranjaSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fondo_franja_semanal"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="12dp" />

                <ImageView
                    android:id="@+id/ivLlamaRacha"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:src="@drawable/ic_llama"
                    app:tint="?attr/themeAcento" />

                <TextView
                    android:id="@+id/tvRachaActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:textColor="?attr/themeTextoPrimario"
                    android:textSize="40sp"
                    tools:text="7" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:text="@string/analisis_racha"
                    android:textColor="?attr/themeTextoTerciario"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMensajeRacha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:textColor="?attr/themeTextoSecundario"
                    android:textSize="12sp"
                    tools:text="Ya enfocaste hoy, bien hecho" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTiempoTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:textColor="?attr/themeTextoPrimario"
                            android:textSize="19sp"
                            tools:text="18h 40m" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:text="@string/analisis_enfoque_total"
                            android:textColor="?attr/themeTextoTerciario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/themeAcentoOverlay20" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPomodorosCompletados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:textColor="?attr/themeTextoPrimario"
                            android:textSize="19sp"
                            tools:text="36" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:text="@string/analisis_pomodoros_completados"
                            android:textColor="?attr/themeTextoTerciario"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/themeAcentoOverlay20" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTasaFallos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:textColor="?attr/themeTextoPrimario"
                            android:textSize="19sp"
                            tools:text="12%" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:text="@string/analisis_tasa_fallos"
                            android:textColor="?attr/themeTextoTerciario"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvBloquesAbandonados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:gravity="center"
                            android:textColor="?attr/themeTextoTerciario"
                            android:textSize="11sp"
                            tools:text="3 abandonados" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTituloGrafica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/analisis_grafico_titulo"
                android:textColor="?attr/themeTextoPrimario"
                android:textSize="15sp" />

            <HorizontalScrollView
                android:id="@+id/hsvGraficaBarras"
                android:layout_width="match_parent"
                android:layout_height="248dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/carta_oscura"
                android:paddingHorizontal="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llContenedorBarras"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvTituloActividades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/analisis_actividades_recientes"
                android:textColor="?attr/themeTextoPrimario"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/llActividadesRecientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/carta_oscura"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:id="@+id/llFilasActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/estadoVacioActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="28dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:alpha="0.18"
                        android:src="@drawable/ic_huella_gato"
                        app:tint="?attr/themeAcento" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/analisis_sin_actividades"
                        android:textColor="?attr/themeTextoTerciario"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVerTodoActividades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/analisis_ver_todo"
                    android:textColor="?attr/themeAcentoTexto"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/themeFondoBarraNavegacion"
        app:itemIconSize="28dp"
        app:itemIconTint="?attr/themeTextoPrimario"
        app:itemTextColor="?attr/themeTextoPrimario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/navegador_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>