    <!-- Tema por defecto de la aplicación (se sobreescribe en runtime según la preferencia guardada) -->
    <style name="Theme.Pomodoro" parent="Theme.Pomodoro.Dark.Azul" />

    <!-- Chip de hora/minuto SELECCIONADO (state_selected=true): fondo = colorPrimaryContainer,
         enlazado a colorFondoChipActivo (varía según el acento de cada tema). -->
    <!-- Chip NO seleccionado: fondo = colorSurfaceVariant, enlazado a colorFondoChipInactivo
         (igual a la superficie del diálogo, se funde con el fondo). -->
    <style name="ThemeOverlay.MiauFocus.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimaryContainer">?attr/colorFondoChipActivo</item>
        <item name="colorOnPrimaryContainer">?attr/themeTextoPrimario</item>
        <item name="colorSurfaceVariant">?attr/colorFondoChipInactivo</item>
        <item name="colorOnSurfaceVariant">?attr/themeTextoPrimario</item>
    </style>

    <!-- Animaciones de transición entre Activities -->
    <style name="Animation.MiauFocus.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_exit</item>
    </style>

    <!-- Animación de aparición/cierre de los diálogos -->
    <style name="Animation.MiauFocus.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- MaterialAlertDialog con la animación de aparición/cierre de MiauFocus -->
    <style name="ThemeOverlay.MiauFocus.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/Animation.MiauFocus.Dialog</item>
    </style>

    <style name="EstiloTextoNavegador">
        <item name="android:textSize">14sp</item>
    </style>

</resources>
